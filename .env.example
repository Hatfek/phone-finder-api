# ---- Model -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_MODEL_QUALITY=qwen3.5:9b
# MANDATORY false for thinking models such as qwen3.5 — see README "Model"
LLM_REASONING=false

# ---- Search ------------------------------------------------------------
TAVILY_API_KEY=

# ---- Authentication ----------------------------------------------------
# Comma-separated keys. Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# An EMPTY value fails closed: every authenticated route returns 503.
# Never commit a real key — this file is the example, .env is gitignored.
API_KEYS=

# ---- Outbound fetching (SSRF controls) ---------------------------------
# The only hosts the extract node may fetch. Env wins over the label map in tools.py.
ALLOWED_DOMAINS=amazon.com,bestbuy.com,bhphotovideo.com,gsmarena.com,store.google.com,apple.com,samsung.com,walmart.com
# true  = a 3xx is refused outright (default, safest)
# false = redirects followed, but every hop is re-validated against ALLOWED_DOMAINS
#         and rejected if it resolves to a private or loopback address
DISABLE_REDIRECTS=true

# ---- Storage -----------------------------------------------------------
# DATABASE_URL is canonical; CHECKPOINT_DB is the fallback if it is unset.
DATABASE_URL=sqlite:///state.db
CHECKPOINT_DB=state.db
CACHE_TTL_HOURS=24

# ---- Observability -----------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phone-finder
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Timeouts and caps -------------------------------------------------
FETCH_TIMEOUT=10
LLM_TIMEOUT=60
TURN_TIMEOUT=150
MAX_QUESTIONS=4

# ---- Transport ---------------------------------------------------------
# REQUIRED — must be set explicitly to the real origin the UI is served from.
# No wildcards. The placeholder below matches nothing and will fail loudly.
# Local dev is usually http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGINS=https://your-frontend-domain.example
# Per-IP limit on the four turn-running routes.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Per-IP ceiling across every route, applied on top of the limit above.
GLOBAL_RATE_LIMIT_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_TURNS=4
MAX_REQUEST_BYTES=10485760

# ---- Display -----------------------------------------------------------
PRICE_REFERENCE=US retail, USD
# Server-wide reload and verbose logging. Separate from DEBUG_UI.
DEBUG=false
# Ships the backend inspector drawer to every visitor.
DEBUG_UI=false
